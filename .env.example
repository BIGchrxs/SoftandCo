# Copy this file to .env and fill in real values. .env is gitignored - never commit it.

# Password for the local Postgres container (docker-compose only; production uses AWS Secrets Manager).
POSTGRES_PASSWORD=change_me_locally

# Bootstrap administrator created on first run, only when the database has no users at all.
SEED_ADMIN_EMAIL=admin@softandco.co.za
SEED_ADMIN_PASSWORD=

# ExchangeRate-API key for Docker. For Visual Studio use .NET user secrets (see README).
EXCHANGE_RATE_API_KEY=

# SMTP for payment-request emails (Docker only). Leave blank in development: the app writes the
# composed message to App_Data/sent-email instead of sending it. For Visual Studio use .NET user
# secrets (see README).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=noreply@softandco.co.za
EMAIL_FROM_NAME=Soft & Co.
