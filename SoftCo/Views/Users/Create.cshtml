@model SoftCo.ViewModels.CreateUserViewModel
@{
    ViewData["Title"] = "Onboard a user";
}

<div class="sc-card">
    <form method="post" asp-action="Create">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="sc-errors"></div>

        <p class="sc-label">Person</p>
        <div class="sc-form-grid">
            <div>
                <label class="form-label" asp-for="FirstName"></label>
                <input class="form-control" asp-for="FirstName" autocomplete="off" />
            </div>
            <div>
                <label class="form-label" asp-for="LastName"></label>
                <input class="form-control" asp-for="LastName" autocomplete="off" />
            </div>
            <div>
                <label class="form-label" asp-for="Email"></label>
                <input class="form-control" asp-for="Email" type="email" autocomplete="off" />
                <span asp-validation-for="Email" class="sc-error"></span>
                <span class="sc-hint">This is also their sign-in name.</span>
            </div>
        </div>

        <hr class="sc-rule" />

        <p class="sc-label">Access</p>
        <div class="sc-form-grid">
            <div>
                <label class="form-label" asp-for="Role"></label>
                <select class="form-select" asp-for="Role">
                    @foreach (var r in SoftCo.Data.Roles.Assignable)
                    {
                        <option value="@r" selected="@(Model.Role == r)">@SoftCo.Data.Roles.Label(r)</option>
                    }
                </select>
                <span class="sc-hint">
                    Staff do the day-to-day work and raise purchase orders, invoices and payment
                    requests. The Financial Director and the Director can do all of that
                    <em>and</em> approve it &mdash; but never their own submissions, so adding an
                    approver means work can be cleared without waiting on one person. Only
                    administrators manage user accounts.
                </span>
                <span asp-validation-for="Role" class="sc-error"></span>
            </div>
        </div>

        <hr class="sc-rule" />

        <p class="sc-label">First sign-in</p>
        <div class="sc-form-grid">
            <div>
                <label class="form-label" asp-for="Password"></label>
                <input class="form-control" asp-for="Password" type="password" autocomplete="new-password" />
                <span asp-validation-for="Password" class="sc-error"></span>
            </div>
            <div>
                <label class="form-label" asp-for="ConfirmPassword"></label>
                <input class="form-control" asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="sc-error"></span>
                <span class="sc-hint">
                    At least 12 characters with upper and lower case, a digit and a symbol.
                </span>
            </div>
        </div>

        <p class="sc-muted" style="font-size:.85rem">
            Give this to them in person or over a channel you trust &mdash; not in the same email as
            the link. They will be asked to replace it the first time they sign in, and it stops
            working at that point.
        </p>

        <hr class="sc-rule" />

        <p class="sc-label">Access</p>
        <p class="sc-muted" style="font-size:.85rem">
            Standard access: orders, payments, documents and payment requests. Not user
            administration. Per-person permissions come later.
        </p>

        <hr class="sc-rule" />

        <button type="submit" class="btn btn-primary">Create account</button>
        <a class="btn btn-secondary" asp-action="Index">Cancel</a>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
