@model SoftCo.ViewModels.ResetUserPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
}

<div class="sc-card">
    <p class="sc-label">Account</p>
    <p class="sc-po-display">@Model.Email</p>

    <hr class="sc-rule" />

    <form method="post" asp-action="ResetPassword">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="UserId" />
        <div asp-validation-summary="ModelOnly" class="sc-errors"></div>

        <div class="sc-form-grid">
            <div>
                <label class="form-label" asp-for="Password"></label>
                <input class="form-control" asp-for="Password" type="password" autocomplete="new-password" />
                <span asp-validation-for="Password" class="sc-error"></span>
            </div>
            <div>
                <label class="form-label" asp-for="ConfirmPassword"></label>
                <input class="form-control" asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="sc-error"></span>
                <span class="sc-hint">At least 12 characters with upper and lower case, a digit and a symbol.</span>
            </div>
        </div>

        <p class="sc-muted" style="font-size:.85rem">
            Any session this person currently has open will be signed out, and they will be asked to
            set their own password the next time they sign in. Any lockout is cleared.
        </p>

        <hr class="sc-rule" />

        <button type="submit" class="btn btn-primary">Reset password</button>
        <a class="btn btn-secondary" asp-action="Index">Cancel</a>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
