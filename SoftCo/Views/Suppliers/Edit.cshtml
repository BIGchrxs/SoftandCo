@model SoftCo.Models.Supplier
@using SoftCo.Models
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "New supplier" : "Edit supplier";
}

<div class="sc-card">
    <form method="post" asp-action="@(isNew ? "Create" : "Edit")">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="sc-errors"></div>

        <div class="sc-form-grid">
            <div>
                <label class="form-label" asp-for="Name">Name</label>
                <input class="form-control" asp-for="Name" />
                <span asp-validation-for="Name" class="sc-error"></span>
            </div>
            <div>
                <label class="form-label" asp-for="Origin">Origin</label>
                <select class="form-select" asp-for="Origin" id="supplierOrigin">
                    @foreach (SupplierOrigin o in Enum.GetValues<SupplierOrigin>())
                    {
                        <option value="@o" selected="@(Model.Origin == o)">@o.Label()</option>
                    }
                </select>
                <span class="sc-hint">Local suppliers invoice in Rand; international ones ship and clear customs.</span>
            </div>
            <div>
                <label class="form-label" asp-for="Type">Type</label>
                <select class="form-select" asp-for="Type">
                    @foreach (SupplierType t in Enum.GetValues<SupplierType>())
                    {
                        <option value="@t" selected="@(Model.Type == t)">@t.Label()</option>
                    }
                </select>
            </div>
            <div>
                <label class="form-label" asp-for="Country">Country</label>
                <input class="form-control" asp-for="Country" />
            </div>
            <div>
                <label class="form-label" asp-for="DefaultCurrencyCode">Default currency</label>
                <select class="form-select" asp-for="DefaultCurrencyCode" id="supplierCurrency">
                    <option value="ZAR" selected="@(Model.DefaultCurrencyCode == "ZAR")">ZAR</option>
                    <option value="CNY" selected="@(Model.DefaultCurrencyCode == "CNY")">CNY</option>
                    <option value="USD" selected="@(Model.DefaultCurrencyCode == "USD")">USD</option>
                    <option value="EUR" selected="@(Model.DefaultCurrencyCode == "EUR")">EUR</option>
                </select>
            </div>
            <div>
                <label class="form-label" asp-for="ContactName">Contact</label>
                <input class="form-control" asp-for="ContactName" />
            </div>
            <div>
                <label class="form-label" asp-for="ContactEmail">Contact email</label>
                <input class="form-control" asp-for="ContactEmail" />
            </div>
        </div>

        <div style="margin-top:1rem">
            <label class="sc-check"><input type="checkbox" asp-for="IsActive" /> <span>Active</span></label>
        </div>

        <hr class="sc-rule" />
        <button type="submit" class="btn btn-primary">@(isNew ? "Add supplier" : "Save changes")</button>
        <a class="btn btn-secondary" asp-action="Index">Cancel</a>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
