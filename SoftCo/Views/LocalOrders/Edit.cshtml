@model SoftCo.ViewModels.OrderEditViewModel
@using SoftCo.Models
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "New local order" : $"Edit {Model.PoNumber}";
}

<div class="sc-card">
    <form method="post" asp-action="@(isNew ? "Create" : "Edit")">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly" class="sc-errors"></div>

        @if (!isNew && !string.IsNullOrWhiteSpace(Model.PoNumber))
        {
            <p class="sc-label">Purchase order</p>
            <p class="sc-po-display">@Model.PoNumber</p>
            <p class="sc-hint">Allocated when the order was created and never changes.</p>
            <hr class="sc-rule" />
        }
        else
        {
            <p class="sc-hint">A PO number is allocated automatically when you save.</p>
        }

        <p class="sc-label">Order</p>
        <div class="sc-form-grid">
            <div>
                <label class="form-label" asp-for="SupplierId"></label>
                <select class="form-select" asp-for="SupplierId">
                    <option value="">Select a supplier</option>
                    @foreach (var s in Model.AllSuppliers)
                    {
                        <option value="@s.Id" selected="@(Model.SupplierId == s.Id)">@s.Name</option>
                    }
                </select>
                <span asp-validation-for="SupplierId" class="sc-error"></span>
            </div>

            <div>
                <label class="form-label" asp-for="ProductDescription"></label>
                <input class="form-control" asp-for="ProductDescription" />
                <span asp-validation-for="ProductDescription" class="sc-error"></span>
            </div>

            <div>
                <label class="form-label" asp-for="FulfilmentStatus">Stage</label>
                <select class="form-select" asp-for="FulfilmentStatus">
                    @foreach (var fs in EnumLabels.LocalStages)
                    {
                        <option value="@fs" selected="@(Model.FulfilmentStatus == fs)">@fs.LocalLabel()</option>
                    }
                </select>
            </div>
        </div>

        <hr class="sc-rule" />

        @await Html.PartialAsync("_ProjectAllocation", Model)

        <hr class="sc-rule" />

        @* Local orders are bought in Rand. No currency, exchange rate or cargo-readiness date -
           the controller fixes ZAR at a rate of 1 on the server regardless of what is posted. *@
        <p class="sc-label">Invoice</p>
        <div class="sc-form-grid">
            <div>
                <label class="form-label" asp-for="InvoiceRef"></label>
                <input class="form-control" asp-for="InvoiceRef" />
            </div>
            <div>
                <label class="form-label" asp-for="InvoiceDate"></label>
                <input class="form-control" type="date" asp-for="InvoiceDate" />
            </div>
            <div>
                <label class="form-label" asp-for="InvoiceValueZar">Invoice value (ZAR)</label>
                <input class="form-control" type="number" step="0.01" asp-for="InvoiceValueZar" />
                <span asp-validation-for="InvoiceValueZar" class="sc-error"></span>
            </div>
        </div>
            <div>
                <label class="form-label" asp-for="VatTreatment"></label>
                <select class="form-select" asp-for="VatTreatment">
                    @foreach (SupplierVatTreatment t in Enum.GetValues<SupplierVatTreatment>())
                    {
                        <option value="@t" selected="@(Model.VatTreatment == t)">@t.Label()</option>
                    }
                </select>
                @* Needed for gross profit. A local invoice usually includes VAT that Soft & Co
                   reclaim, so the real cost is lower; an import carries no SA VAT at all. Left
                   unrecorded, the full value is counted as cost and margin reads low. *@
                <span class="sc-hint">
                    Does the Rand value above include South African VAT? Until this is set, the whole
                    amount counts as cost and gross profit is understated.
                </span>
            </div>

        <div style="margin-top:1rem">
            <label class="form-label" asp-for="Notes"></label>
            <textarea class="form-control" asp-for="Notes" rows="3"></textarea>
        </div>

        <hr class="sc-rule" />

        <button type="submit" class="btn btn-primary">@(isNew ? "Create local order" : "Save changes")</button>
        <a class="btn btn-secondary" asp-action="Index">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/project-allocation.js" asp-append-version="true"></script>
}
