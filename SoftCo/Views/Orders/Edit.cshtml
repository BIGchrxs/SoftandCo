@model SoftCo.ViewModels.OrderEditViewModel
@using SoftCo.Models
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "New order" : "Edit order";
}

<div class="sc-card">
    <form method="post" asp-action="@(isNew ? "Create" : "Edit")">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly" class="sc-errors"></div>

        <p class="sc-label">Order</p>
        <div class="sc-form-grid">
            <div>
                <label class="form-label" asp-for="SupplierId"></label>
                <select class="form-select" asp-for="SupplierId">
                    <option value="">Select a supplier</option>
                    @foreach (var s in Model.AllSuppliers)
                    {
                        <option value="@s.Id" selected="@(Model.SupplierId == s.Id)">@s.Name</option>
                    }
                </select>
                <span asp-validation-for="SupplierId" class="sc-error"></span>
            </div>

            <div>
                <label class="form-label" asp-for="ProductDescription"></label>
                <input class="form-control" asp-for="ProductDescription" />
                <span asp-validation-for="ProductDescription" class="sc-error"></span>
            </div>

            <div>
                <label class="form-label" asp-for="FulfilmentStatus"></label>
                <select class="form-select" asp-for="FulfilmentStatus">
                    @foreach (FulfilmentStatus fs in Enum.GetValues<FulfilmentStatus>())
                    {
                        <option value="@fs" selected="@(Model.FulfilmentStatus == fs)">@((int)fs). @fs.Label()</option>
                    }
                </select>
            </div>

            <div>
                <label class="form-label" asp-for="CargoReadinessDate"></label>
                <input class="form-control" type="date" asp-for="CargoReadinessDate" />
            </div>
        </div>

        <hr class="sc-rule" />

        @await Html.PartialAsync("_ProjectAllocation", Model)

        <hr class="sc-rule" />

        <p class="sc-label">Invoice</p>
        <div class="sc-form-grid">
            <div>
                <label class="form-label" asp-for="InvoiceRef"></label>
                <input class="form-control" asp-for="InvoiceRef" />
            </div>
            <div>
                <label class="form-label" asp-for="InvoiceDate"></label>
                <input class="form-control" type="date" asp-for="InvoiceDate" />
            </div>
            <div>
                <label class="form-label" asp-for="CurrencyCode"></label>
                <select class="form-select" asp-for="CurrencyCode">
                    <option value="CNY" selected="@(Model.CurrencyCode == "CNY")">CNY — Chinese yuan</option>
                    <option value="USD" selected="@(Model.CurrencyCode == "USD")">USD — US dollar</option>
                    <option value="EUR" selected="@(Model.CurrencyCode == "EUR")">EUR — Euro</option>
                </select>
            </div>
            <div>
                <label class="form-label" asp-for="ExchangeRate" for="rate"></label>
                <input class="form-control" type="number" step="0.000001" min="0.000001" required asp-for="ExchangeRate" id="rate" aria-describedby="rate-status" data-auto-fetch="@((isNew && ViewData.ModelState.Count == 0) ? "true" : "false")" />
                <span asp-validation-for="ExchangeRate" class="sc-error"></span>
                <div style="margin-top:0.5rem">
                    <button type="button" id="refresh-rate" class="btn btn-secondary">Refresh rate</button>
                    <span id="rate-status" class="sc-hint" role="status" aria-live="polite"></span>
                </div>
            </div>
            <div>
                <label class="form-label" asp-for="InvoiceValueForeign" for="foreign"></label>
                <input class="form-control" type="number" step="0.01" asp-for="InvoiceValueForeign" id="foreign" />
                <span asp-validation-for="InvoiceValueForeign" class="sc-error"></span>
            </div>
            <div>
                <label class="form-label" asp-for="InvoiceValueZar" for="zar"></label>
                <input class="form-control" type="number" step="0.01" asp-for="InvoiceValueZar" id="zar" />
                <span class="sc-hint">Auto-calculated from the rate; override if finance agreed a different Rand figure.</span>
            </div>
        </div>
            <div>
                <label class="form-label" asp-for="VatTreatment"></label>
                <select class="form-select" asp-for="VatTreatment">
                    @foreach (SupplierVatTreatment t in Enum.GetValues<SupplierVatTreatment>())
                    {
                        <option value="@t" selected="@(Model.VatTreatment == t)">@t.Label()</option>
                    }
                </select>
                @* Needed for gross profit. A local invoice usually includes VAT that Soft & Co
                   reclaim, so the real cost is lower; an import carries no SA VAT at all. Left
                   unrecorded, the full value is counted as cost and margin reads low. *@
                <span class="sc-hint">
                    Does the Rand value above include South African VAT? Until this is set, the whole
                    amount counts as cost and gross profit is understated.
                </span>
            </div>

        <div style="margin-top:1rem">
            <label class="form-label" asp-for="Notes"></label>
            <textarea class="form-control" asp-for="Notes" rows="3"></textarea>
        </div>

        <hr class="sc-rule" />

        <button type="submit" class="btn btn-primary">@(isNew ? "Create order" : "Save changes")</button>
        <a class="btn btn-secondary" asp-action="Index">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const currency = document.getElementById('CurrencyCode');
            const rate = document.getElementById('rate');
            const foreign = document.getElementById('foreign');
            const zar = document.getElementById('zar');
            const status = document.getElementById('rate-status');
            const refresh = document.getElementById('refresh-rate');
            if (!currency || !rate || !foreign || !zar || !status || !refresh) return;
        
            const autoFetch = rate.dataset.autoFetch === 'true';
            const initialTotal = Number(rate.value) * Number(foreign.value);
            let manual = !autoFetch && zar.value !== '' &&
                (rate.value === '' || foreign.value === '' ||
                 !Number.isFinite(initialTotal) ||
                 Math.abs(Number(zar.value) - Number(initialTotal.toFixed(2))) > 0.005);
            let requestId = 0;
            let pending = false;
            let controller;
        
            function recalc() {
                if (manual) return;
                const r = Number(rate.value);
                const f = Number(foreign.value);
                zar.value = rate.value !== '' && foreign.value !== '' &&
                    Number.isFinite(r) && r > 0 && Number.isFinite(f) && Number.isFinite(r * f)
                    ? (r * f).toFixed(2) : '';
            }
        
            zar.addEventListener('input', function () {
                // Clearing an override resumes automatic calculation.
                manual = zar.value !== '';
                if (!manual) recalc();
            });
            foreign.addEventListener('input', recalc);
            rate.addEventListener('input', function () {
                // A manual entry takes priority over any pending response.
                ++requestId;
                if (controller) controller.abort();
                pending = false;
                status.textContent = 'Manual exchange rate.';
                recalc();
            });
        
            async function fetchRate() {
                const currentRequest = ++requestId;
                if (controller) controller.abort();
                controller = new AbortController();
                const activeController = controller;
                const timeout = setTimeout(function () { activeController.abort(); }, 10000);
                const base = currency.value;
                pending = true;
                rate.value = '';
                recalc();
                status.textContent = 'Fetching latest daily rate…';
        
                try {
                    if (!['CNY', 'USD', 'EUR'].includes(base)) throw new Error('Unsupported currency');
                    const response = await fetch(
                        'https://api.frankfurter.dev/v2/rate/' + base + '/ZAR',
                        { signal: activeController.signal }
                    );
                    if (!response.ok) throw new Error('Rate unavailable');
                    const data = await response.json();
                    if (currentRequest !== requestId) return;
                    if (data.base !== base || data.quote !== 'ZAR' ||
                        !Number.isFinite(data.rate) || data.rate < 0.000001 ||
                        typeof data.date !== 'string' || !/^\d{4}-\d{2}-\d{2}$/.test(data.date)) {
                        throw new Error('Invalid rate response');
                    }
                    rate.value = data.rate.toFixed(6);
                    status.textContent = '1 ' + base + ' = R' + rate.value +
                        ' · Rate dated ' + data.date + ' · Frankfurter';
                    recalc();
                } catch {
                    if (currentRequest !== requestId) return;
                    status.textContent = 'Could not fetch the rate. Enter it manually or click Refresh rate.';
                } finally {
                    clearTimeout(timeout);
                    if (currentRequest === requestId) pending = false;
                }
            }
        
            rate.form.addEventListener('submit', function (event) {
                if (pending || rate.value === '' || !Number.isFinite(Number(rate.value)) ||
                    Number(rate.value) < 0.000001) {
                    event.preventDefault();
                    event.stopImmediatePropagation();
                    status.textContent = pending ? 'Wait for the rate, or enter it manually.'
                        : 'Enter a positive exchange rate before saving.';
                    rate.focus();
                }
            }, true);
        
            currency.addEventListener('change', fetchRate);
            refresh.addEventListener('click', fetchRate);
            if (autoFetch) fetchRate();
            else status.textContent = 'Existing rate retained. Refresh rate to use the latest daily rate.';
        })();
        
    </script>
    <script src="~/js/project-allocation.js" asp-append-version="true"></script>
}

