@model SoftCo.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
    var forced = ViewBag.Forced is true;
}

<div class="sc-card">
    @if (forced)
    {
        <p class="sc-label">Set your own password</p>
        <p class="sc-muted">
            Your account was opened with a password someone else chose. Replace it before carrying
            on &mdash; nothing else is reachable until you do.
        </p>
        <hr class="sc-rule" />
    }

    <form method="post" asp-action="ChangePassword">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="sc-errors"></div>

        <div class="sc-form-grid">
            <div>
                <label class="form-label" asp-for="CurrentPassword"></label>
                <input class="form-control" asp-for="CurrentPassword" type="password" autocomplete="current-password" />
                <span asp-validation-for="CurrentPassword" class="sc-error"></span>
            </div>
            <div>
                <label class="form-label" asp-for="NewPassword"></label>
                <input class="form-control" asp-for="NewPassword" type="password" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="sc-error"></span>
                <span class="sc-hint">At least 12 characters with upper and lower case, a digit and a symbol.</span>
            </div>
            <div>
                <label class="form-label" asp-for="ConfirmPassword"></label>
                <input class="form-control" asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="sc-error"></span>
            </div>
        </div>

        <hr class="sc-rule" />

        <button type="submit" class="btn btn-primary">Change password</button>
        @if (!forced)
        {
            <a class="btn btn-secondary" asp-controller="Orders" asp-action="Index">Cancel</a>
        }
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
