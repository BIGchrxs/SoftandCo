<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SoftCo</RootNamespace>
    <UserSecretsId>0b0fc333-4dcf-447c-a1c5-be8a05804621</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>

    <!-- Order attachments and development email land under App_Data at runtime. Keeping that
         folder out of MSBuild's implicit globs stops Visual Studio's Hot Reload watcher from
         treating every upload as a project change and tearing down the debug session with no
         exception - just "exited with code -1". -->
    <DefaultItemExcludes>$(DefaultItemExcludes);App_Data/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- The brand faces, embedded rather than installed. PDFsharp 6 has no access to system fonts
         on .NET Core, so without these the renderer throws - on Linux especially, which is where
         this would otherwise first be noticed. Manrope and Cormorant Garamond are both SIL Open
         Font Licence, which expressly permits embedding, so the bytes ship inside the assembly and
         the Dockerfile needs no font package. Resource names are matched by EmbeddedFontResolver. -->
    <EmbeddedResource Include="Assets/Fonts/*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <!-- Belt and braces on top of DefaultItemExcludes: Hot Reload computes its watched paths at
         project load, so a folder created only at runtime is not excluded until the project is
         reloaded. Removing it from @(Watch) directly is not subject to that snapshot. -->
    <Watch Remove="App_Data/**" />
  </ItemGroup>

</Project>
